<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.goutou.seeder-watchdog</string>

    <!-- 健康检查器。只探 HTTP，判死就 kill 服务进程让 KeepAlive 拉回；
         不 spawn 进程、不需要 root。同样以 jason 身份跑。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jason/Dev/jhfnetboy/goutou/scripts/seeder-daemon.sh</string>
    </array>

    <key>UserName</key>
    <string>jason</string>
    <key>GroupName</key>
    <string>staff</string>

    <key>WorkingDirectory</key>
    <string>/Users/jason/Dev/jhfnetboy/goutou</string>

    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/jason/Dev/jhfnetboy/goutou/.seeder-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jason/Dev/jhfnetboy/goutou/.seeder-watchdog.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jason</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>
