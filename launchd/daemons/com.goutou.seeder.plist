<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.goutou.seeder</string>

    <!-- LaunchDaemon：开机(解密后)即起，不依赖任何用户登录。
         装到 /Library/LaunchDaemons/，属主 root:wheel 权限 644。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jason/Dev/jhfnetboy/goutou/scripts/seeder-run.sh</string>
    </array>

    <!-- ⚠️ 关键：以 jason 身份运行，而不是默认的 root。
         root 跑 next build 会造出 root 属主的 .next/ 和 sqlite WAL 文件，
         之后用户自己 npm run dev 会 EACCES —— 得 sudo 才能收拾。
         daemon 的价值是「开机即起」，不是「用 root 跑」，两者可以分开。 -->
    <key>UserName</key>
    <string>jason</string>
    <key>GroupName</key>
    <string>staff</string>

    <key>WorkingDirectory</key>
    <string>/Users/jason/Dev/jhfnetboy/goutou</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- 无论因何退出都拉回来 -->
    <key>KeepAlive</key>
    <true/>

    <!-- 两次启动最小间隔，防 boot-crash 刷爆（build 失败路径脚本内另有 120s 退避） -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/jason/Dev/jhfnetboy/goutou/.seeder-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jason/Dev/jhfnetboy/goutou/.seeder-server.log</string>

    <!-- Standard 而非 Background：Background 会被 macOS 降 CPU/IO 优先级 -->
    <key>ProcessType</key>
    <string>Standard</string>

    <!-- daemon 环境比 agent 更空，HOME 必须显式给（脚本用 $HOME 定位仓库和 ~/.claude.json） -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jason</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>
